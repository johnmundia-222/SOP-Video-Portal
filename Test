// --- MAIN APP COMPONENT ---

export default function App() {
  const [user, setUser] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [currentView, setCurrentView] = useState('loading');
  const [portalId, setPortalId] = useState<string | null>(null);
  const { toast, showToast, hideToast } = useToast();

  useEffect(() => {
    const initAuth = async () => {
      try {
        // @ts-ignore
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          // @ts-ignore
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error('Auth error:', error);
        showToast('Authentication failed', 'error');
      }
    };
    
    if (auth) {
      initAuth();
      const unsubscribe = onAuthStateChanged(auth, (u) => {
        setUser(u);
        setLoading(false);
      });
      return () => unsubscribe();
    } else {
      setLoading(false);
    }
  }, [showToast]);

  useEffect(() => {
    if (loading) return;
    const params = new URLSearchParams(window.location.search);
    const pid = params.get('portal');
    
    if (pid) {
      setPortalId(pid);
      setCurrentView('client-experience');
    } else {
      setCurrentView('consultant-login');
    }
  }, [loading]);

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 to-slate-100">
        <div className="text-center">
          <div className="relative w-16 h-16 mx-auto mb-4">
            <div className="absolute inset-0 border-4 border-blue-100 rounded-full"></div>
            <div className="absolute inset-0 border-4 border-[#2e69b3] rounded-full border-t-transparent animate-spin"></div>
          </div>
          <p className="text-slate-600 font-medium">Loading Portal...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased">
      {toast && <Toast {...toast} onClose={hideToast} />}
      {currentView === 'consultant-login' && (
        <ConsultantLogin onLogin={() => setCurrentView('consultant-dashboard')} />
      )}
      {currentView === 'consultant-dashboard' && (
        <ConsultantDashboard user={user} showToast={showToast} />
      )}
      {currentView === 'client-experience' && (
        <ClientExperience portalId={portalId} showToast={showToast} />
      )}
    </div>
  );
}

// --- CLIENT EXPERIENCE WRAPPER ---

function ClientExperience({ portalId, showToast, isPreview = false }: { portalId: string | null, showToast: any, isPreview?: boolean }) {
  const [view, setView] = useState('loading');

  useEffect(() => {
    // If we are in preview mode, we might have auto-created a user
    // Or if normal user, check local storage for session
    const localUser = localStorage.getItem(`training_portal_user_${portalId}`);
    if (localUser) {
      setView('hub');
    } else {
      setView('choice');
    }
  }, [portalId, isPreview]); // Re-run if preview status changes

  const handleQuickStart = () => {
    // Immediate mocked login with all access for admins - THIS SHOULD NOT NORMALLY BE HIT IN PREVIEW AS WE AUTO-LOGIN
    const mockUser = {
      id: `preview-${portalId}`,
      portalId,
      firstName: 'Admin',
      lastName: 'Preview',
      name: 'Admin Preview',
      email: 'admin@preview.com',
      role: 'Administrator',
      departments: ALL_DEPARTMENTS,
      watched: [],
      watchTimes: {},
      status: 'in-progress',
      isPreview: true,
      joinedAt: new Date().toISOString()
    };
    localStorage.setItem(`training_portal_user_${portalId}`, JSON.stringify(mockUser));
    showToast('⚡ Quick Access: Simulation Started', 'success');
    setView('hub');
  };

  if (view === 'loading') {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <Loader2 className="animate-spin w-8 h-8 text-[#2e69b3]" />
      </div>
    );
  }

  return (
    <>
      {view === 'choice' && (
        <ClientEntryChoice
          portalId={portalId}
          onSelectNew={() => setView('onboard')}
          onSelectReturning={() => setView('login')}
          onQuickStart={handleQuickStart}
          isPreview={isPreview}
        />
      )}
      {view === 'login' && (
        <ClientLogin
          portalId={portalId}
          onLoginSuccess={() => setView('hub')}
          onBack={() => setView('choice')}
          showToast={showToast}
          isPreview={isPreview}
        />
      )}
      {view === 'onboard' && (
        <ClientOnboarding
          portalId={portalId}
          onJoin={() => setView('hub')}
          onBack={() => setView('choice')}
          showToast={showToast}
          isPreview={isPreview}
        />
      )}
      {view === 'hub' && (
        <ClientHub
          portalId={portalId}
          showToast={showToast}
          isPreview={isPreview}
          onLogout={() => {
            localStorage.removeItem(`training_portal_user_${portalId}`);
            setView('choice');
          }}
        />
      )}
    </>
  );
}

