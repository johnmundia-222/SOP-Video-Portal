// --- UTILITY FUNCTIONS ---

const getEmbedUrl = (url: string) => {
  if (!url || url === '#' || !url.includes('drive.google.com')) return null;
  const fileId = url.match(/[-\w]{25,}/);
  if (fileId) {
    return `https://drive.google.com/file/d/${fileId[0]}/preview`;
  }
  return null;
};

// Fetches the raw thumbnail representation for Google Drive videos
const getThumbnailUrl = (url: string) => {
  if (!url || url === '#' || !url.includes('drive.google.com')) return null;
  const fileId = url.match(/[-\w]{25,}/);
  if (fileId) {
    return `https://drive.google.com/thumbnail?id=${fileId[0]}&sz=w800`;
  }
  return null;
};

const getDownloadUrl = (url: string) => {
  if (!url || url === '#' || !url.includes('drive.google.com')) return null;
  const fileId = url.match(/[-\w]{25,}/);
  if (fileId) {
    return `https://drive.google.com/uc?export=download&id=${fileId[0]}`;
  }
  return null;
};

const formatWatchTime = (seconds: number) => {
  if (!seconds) return '0m 0s';
  const hrs = Math.floor(seconds / 3600);
  const mins = Math.floor((seconds % 3600) / 60);
  const secs = seconds % 60;
  if (hrs > 0) return `${hrs}h ${mins}m`;
  return `${mins}m ${secs}s`;
};

// --- TOAST NOTIFICATION SYSTEM ---

const Toast = ({ message, type, onClose }: { message: string, type: 'success' | 'error' | 'info', onClose: () => void }) => {
  useEffect(() => {
    const timer = setTimeout(onClose, 3000);
    return () => clearTimeout(timer);
  }, [onClose]);

  const icons = {
    success: <CheckCircle className="w-5 h-5" />,
    error: <AlertCircle className="w-5 h-5" />,
    info: <Info className="w-5 h-5" />
  };

  const colors = {
    success: 'bg-green-50 border-green-200 text-green-800',
    error: 'bg-red-50 border-red-200 text-red-800',
    info: 'bg-blue-50 border-blue-200 text-blue-800'
  };

  return (
    <div className={`fixed top-4 right-4 z-[100] px-4 py-3 rounded-lg border shadow-lg flex items-center gap-3 animate-in slide-in-from-right ${colors[type]}`}>
      {icons[type]}
      <span className="font-medium text-sm">{message}</span>
      <button onClick={onClose} className="ml-2 hover:opacity-70">
        <X className="w-4 h-4" />
      </button>
    </div>
  );
};

const useToast = () => {
  const [toast, setToast] = useState<{message: string, type: 'success' | 'error' | 'info'} | null>(null);
  const showToast = useCallback((message: string, type: 'success' | 'error' | 'info' = 'info') => {
    setToast({ message, type });
  }, []);
  const hideToast = useCallback(() => setToast(null), []);
  return { toast, showToast, hideToast };
};

