function ClientLogin({ portalId, onLoginSuccess, onBack, showToast, isPreview }: any) {
  const [firstName, setFirstName] = useState('');
  const [lastName, setLastName] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError(null);

    // MOCK LOGIN FOR ADMIN PREVIEW
    if (isPreview) {
      setTimeout(() => {
        const mockUser = {
          id: `preview-${portalId}`,
          portalId,
          firstName: firstName || 'Admin',
          lastName: lastName || 'Preview',
          name: `${firstName} ${lastName}`,
          role: 'Viewer',
          departments: ALL_DEPARTMENTS,
          watched: [],
          watchTimes: {},
          status: 'in-progress',
          isPreview: true,
          joinedAt: new Date().toISOString()
        };
        localStorage.setItem(`training_portal_user_${portalId}`, JSON.stringify(mockUser));
        showToast('Entering Simulation Mode', 'success');
        onLoginSuccess();
      }, 800);
      return;
    }

    try {
      const q = query(
        collection(db, 'artifacts', appId, 'public', 'data', 'client_progress'),
        where('portalId', '==', portalId)
      );

      const snapshot = await getDocs(q);
      const userDoc = snapshot.docs.find(doc => {
        const data = doc.data();
        return (
          data.firstName?.toLowerCase().trim() === firstName.toLowerCase().trim() &&
          data.lastName?.toLowerCase().trim() === lastName.toLowerCase().trim()
        );
      });

      if (userDoc) {
        const userData = { id: userDoc.id, ...userDoc.data() };
        localStorage.setItem(`training_portal_user_${portalId}`, JSON.stringify(userData));
        showToast('Welcome back!', 'success');
        onLoginSuccess();
      } else {
        setError(`No user found with the name "${firstName} ${lastName}". Please check the spelling or go back and create a new user.`);
      }
    } catch (err) {
      console.error(err);
      setError("An error occurred. Please try again.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50 flex flex-col items-center justify-center p-4">
      <div className="w-full max-w-md bg-white rounded-2xl shadow-xl shadow-slate-200/50 p-8 border border-slate-100">
        <button
          onClick={onBack}
          className="text-sm text-slate-400 hover:text-slate-600 mb-6 flex items-center gap-1 transition-colors"
        >
          <ArrowLeft className="w-4 h-4" /> Back
        </button>

        <div className="mb-8">
          <div className="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 border border-slate-100 shadow-sm">
             <FlyntlokLogo className="w-10 h-10" />
          </div>
          <h2 className="text-2xl font-bold text-slate-900 mb-2">Welcome Back {isPreview && '(Preview)'}</h2>
          <p className="text-slate-500">Enter your details to resume training.</p>
        </div>

        <form onSubmit={handleLogin} className="space-y-5">
          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="block text-sm font-semibold text-slate-700 mb-2">First Name</label>
              <input
                value={firstName}
                onChange={e => { setFirstName(e.target.value); setError(null); }}
                className="w-full p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2e69b3] focus:border-transparent outline-none transition-all"
                placeholder="John"
                required
              />
            </div>
            <div>
              <label className="block text-sm font-semibold text-slate-700 mb-2">Last Name</label>
              <input
                value={lastName}
                onChange={e => { setLastName(e.target.value); setError(null); }}
                className="w-full p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2e69b3] focus:border-transparent outline-none transition-all"
                placeholder="Doe"
                required
              />
            </div>
          </div>

          {error && (
            <div className="p-4 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl flex items-start gap-3">
              <AlertCircle className="w-5 h-5 shrink-0 mt-0.5" />
              <span>{error}</span>
            </div>
          )}

          <button
            type="submit"
            disabled={loading}
            className="w-full py-3.5 bg-[#2e69b3] hover:bg-[#255491] disabled:bg-slate-300 text-white font-semibold rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-200"
          >
            {loading ? <Loader2 className="w-5 h-5 animate-spin" /> : <LogIn className="w-5 h-5" />}
            Resume Training
          </button>
        </form>
      </div>
    </div>
  );
}

