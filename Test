function ConsultantDashboard({ user, showToast }: any) {
  const [portals, setPortals] = useState<any[]>([]);
  const [showCreate, setShowCreate] = useState(false);
  const [clientProgressData, setClientProgressData] = useState<any[]>([]);
  const [selectedPortal, setSelectedPortal] = useState<any>(null);
  const [previewPortal, setPreviewPortal] = useState<any>(null);
  const [expandedUserIds, setExpandedUserIds] = useState(new Set());
  const [searchTerm, setSearchTerm] = useState('');
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    if (!user || !db) return;
    
    setIsLoading(true);
    const q = collection(db, 'artifacts', appId, 'public', 'data', 'portals');
    const unsub = onSnapshot(q, (snapshot) => {
      const p = snapshot.docs.map(d => ({ id: d.id, ...d.data() }));
      p.sort((a: any, b: any) => b.createdAt?.seconds - a.createdAt?.seconds);
      setPortals(p);
      setIsLoading(false);
    }, (error) => {
      console.error('Error fetching portals:', error);
      showToast('Error loading portals', 'error');
      setIsLoading(false);
    });
    return () => unsub();
  }, [user, showToast]);

  useEffect(() => {
    if (!user || !db) return;
    const q = collection(db, 'artifacts', appId, 'public', 'data', 'client_progress');
    const unsub = onSnapshot(q, (snapshot) => {
      const data = snapshot.docs.map(d => ({ id: d.id, ...d.data() }));
      setClientProgressData(data);
    });
    return () => unsub();
  }, [user]);

  const toggleUserExpand = (userId: any) => {
    const newSet = new Set(expandedUserIds);
    if (newSet.has(userId)) {
      newSet.delete(userId);
    } else {
      newSet.add(userId);
    }
    setExpandedUserIds(newSet);
  };

  const handleCreatePortal = async (e: React.FormEvent) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    
    try {
      await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'portals'), {
        company: formData.get('company'),
        contactEmail: formData.get('email'),
        consultantEmail: formData.get('consultantEmail'),
        createdAt: serverTimestamp(),
        consultantId: user.uid,
        status: 'active'
      });
      showToast('Portal created successfully!', 'success');
      setShowCreate(false);
      (e.target as HTMLFormElement).reset();
    } catch (error) {
      console.error(error);
      showToast('Failed to create portal', 'error');
    }
  };

  const handleDeletePortal = async (portalId: string) => {
    if (!confirm('Are you sure? This will delete all data for this client.')) return;
    
    try {
      await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'portals', portalId));
      const relatedProgress = clientProgressData.filter(p => p.portalId === portalId);
      
      const batch = writeBatch(db);
      relatedProgress.forEach(p => {
        batch.delete(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', p.id));
      });
      await batch.commit();
      
      // Also clear local storage for preview user
      localStorage.removeItem(`training_portal_user_${portalId}`);

      showToast('Portal deleted', 'success');
      if (selectedPortal?.id === portalId) setSelectedPortal(null);
    } catch (error) {
      console.error(error);
      showToast('Failed to delete portal', 'error');
    }
  };

  const handleStartPreview = async (portal: any) => {
    // Automatically create a simulated user for the admin in FIRESTORE
    // We use a known ID format so we can track it, and delete it later.
    const previewUserId = `preview-${portal.id}`;
    
    const mockUser = {
      portalId: portal.id,
      firstName: 'Admin',
      lastName: 'Preview',
      name: 'Admin Preview (Simulated)',
      email: portal.consultantEmail || 'admin@preview.com',
      role: 'Administrator',
      departments: ALL_DEPARTMENTS,
      watched: [],
      watchTimes: {},
      status: 'in-progress',
      joinedAt: serverTimestamp(), // Use server timestamp so it looks real on dashboard
      isPreview: true,
      isTransient: true // Flag to identify for cleanup
    };

    try {
        // Save to Firestore so it shows up on dashboard
        await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', previewUserId), mockUser);
        
        // Also set in local storage for the client app to pick up immediately
        localStorage.setItem(`training_portal_user_${portal.id}`, JSON.stringify({
            id: previewUserId,
            ...mockUser,
            joinedAt: new Date().toISOString() // Fallback for local
        }));
        
        setPreviewPortal(portal);
        showToast('Entering Preview Mode. User created.', 'success');
    } catch (error) {
        console.error("Failed to create preview user", error);
        showToast("Failed to initialize preview", "error");
    }
  };

  const handleExitPreview = async () => {
    if (!previewPortal) return;
    const previewUserId = `preview-${previewPortal.id}`;
    
    try {
        // Cleanup the transient user to "not clog the database"
        await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', previewUserId));
        localStorage.removeItem(`training_portal_user_${previewPortal.id}`);
        setPreviewPortal(null);
        showToast('Exited Preview. Temporary user deleted.', 'success');
    } catch (error) {
        console.error("Error cleaning up preview user", error);
        setPreviewPortal(null);
    }
  };

  const filteredPortals = portals.filter(p => 
    p.company?.toLowerCase().includes(searchTerm.toLowerCase()) ||
    p.contactEmail?.toLowerCase().includes(searchTerm.toLowerCase())
  );

  // Users from Firestore are enough now since we save the preview user to Firestore transiently
  const getUsersForPortal = (portalId: string) => {
    return clientProgressData.filter(u => u.portalId === portalId);
  };

  if (previewPortal) {
    return (
      <div className="min-h-screen bg-slate-100">
        <div className="bg-slate-900 text-white px-6 py-3 flex justify-between items-center sticky top-0 z-[60] shadow-md">
          <div className="flex items-center gap-3">
            <div className="px-3 py-1 bg-amber-500 text-slate-900 text-xs font-bold rounded uppercase tracking-wider">
              Admin Preview
            </div>
            <span className="font-medium text-slate-200">{previewPortal.company}</span>
          </div>
          <button
            onClick={handleExitPreview}
            className="flex items-center gap-2 text-sm bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg border border-slate-700 transition-colors"
          >
            <X className="w-4 h-4" /> Exit Preview
          </button>
        </div>
        <ClientExperience portalId={previewPortal.id} showToast={showToast} isPreview={true} />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col font-sans">
      {/* Top Navigation */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div className="max-w-[1600px] mx-auto px-6 h-16 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 bg-gradient-to-br from-[#cf7a28] to-[#2e69b3] rounded-lg flex items-center justify-center shadow-sm border border-slate-100">
              <FlyntlokLogo className="w-5 h-5 text-white" />
            </div>
            <h1 className="text-lg font-bold text-slate-800 tracking-tight">Consultant Dashboard</h1>
          </div>
          
          <div className="flex items-center gap-4">
            <button 
              onClick={() => setShowCreate(true)}
              className="bg-[#2e69b3] hover:bg-[#255491] text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-all shadow-md shadow-blue-100"
            >
              <Plus className="w-4 h-4" /> New Portal
            </button>
          </div>
        </div>
      </header>

      {/* Main Workspace */}
      <div className="flex-1 max-w-[1600px] w-full mx-auto px-6 py-8 flex gap-8 h-[calc(100vh-64px)] min-h-[600px]">
        
        {/* Left Sidebar: Portal List */}
        <div className="w-1/3 flex flex-col bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden h-full">
          <div className="p-4 border-b border-slate-100 bg-slate-50/50">
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
              <input
                type="text"
                placeholder="Search clients..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-[#2e69b3] outline-none transition-all"
              />
            </div>
          </div>
          
          <div className="flex-1 overflow-y-auto p-2 space-y-1">
            {isLoading ? (
              <div className="p-8 flex justify-center"><Loader2 className="w-6 h-6 animate-spin text-slate-300" /></div>
            ) : filteredPortals.length === 0 ? (
