function ClientHub({ portalId, showToast, onLogout, isPreview }: any) {
  const [userData, setUserData] = useState<any>(null);
  const [userId, setUserId] = useState<string | null>(null);
  const [activeCategory, setActiveCategory] = useState<string | null>(null);
  const [playingVideoId, setPlayingVideoId] = useState<string | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const [showConfetti, setShowConfetti] = useState(false);
  const [portalInfo, setPortalInfo] = useState<any>(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [showMobileMenu, setShowMobileMenu] = useState(false);

  // Time Tracking Refs
  const activeVideoRef = useRef<string | null>(null);
  const sessionStartRef = useRef<number | null>(null);
  const stateRefs = useRef({ isPreview, userId, userData, portalId });

  // Update Refs on change for cleanup closures
  useEffect(() => {
    stateRefs.current = { isPreview, userId, userData, portalId };
  }, [isPreview, userId, userData, portalId]);

  useEffect(() => {
    const fetchPortal = async () => {
      if (!db) return;
      try {
        const snap = await getDocs(query(collection(db, 'artifacts', appId, 'public', 'data', 'portals')));
        const found = snap.docs.find(d => d.id === portalId);
        if (found) setPortalInfo(found.data());
      } catch (error) {
        console.error('Error fetching portal:', error);
      }
    };
    if (portalId) fetchPortal();

    const local = localStorage.getItem(`training_portal_user_${portalId}`);
    if (local) {
      const parsedUser = JSON.parse(local);
      setUserId(parsedUser.id);
      setActiveCategory(getAssignedDepartments(parsedUser)[0]);
      
      // If preview user (transient), we prefer the local storage for immediate load but sync with Firestore
      // Note: If it's a manual preview user (id starts with preview-manual), we ONLY use local storage.
      // If it's the auto-created one (id starts with preview-), it is in Firestore.
      if (parsedUser.id.startsWith('preview-manual')) {
        setUserData(parsedUser);
      }
    }
  }, [portalId, isPreview]);

  useEffect(() => {
    if (!userId || !db) return;
    
    // If it's a manual preview user (mocked), don't try to fetch from Firestore
    if (userId.startsWith('preview-manual')) return;

    const unsub = onSnapshot(
      doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', userId),
      (doc) => {
        if (doc.exists()) {
          setUserData(doc.data());
        } else {
          // If doc deleted (e.g. admin exited preview), logout
          localStorage.removeItem(`training_portal_user_${portalId}`);
          if (onLogout) onLogout();
        }
      },
      (error) => {
        console.error('Error fetching user data:', error);
        if (error.code === 'permission-denied') {
           localStorage.removeItem(`training_portal_user_${portalId}`);
           if (onLogout) onLogout();
        }
      }
    );
    return () => unsub();
  }, [userId, portalId, onLogout]);

  // --- TIME TRACKING EFFECTS ---
  useEffect(() => {
    const saveCurrentSession = () => {
      const { isPreview: preview, userId: uid, userData: uData, portalId: pId } = stateRefs.current;
      if (!activeVideoRef.current || !sessionStartRef.current) return;
      
      const elapsed = Math.floor((Date.now() - sessionStartRef.current) / 1000);
      if (elapsed <= 0) return;

      if (uid && uid.startsWith('preview-manual')) {
         // Update Local Storage for Manual Preview Mode (Mock)
         if (uData && pId) {
             const updatedTimes = { ...uData.watchTimes };
             updatedTimes[activeVideoRef.current] = (updatedTimes[activeVideoRef.current] || 0) + elapsed;
             
             const updatedUser = { ...uData, watchTimes: updatedTimes };
             stateRefs.current.userData = updatedUser;
             setUserData(updatedUser);
             localStorage.setItem(`training_portal_user_${pId}`, JSON.stringify(updatedUser));
         }
      } else if (uid) {
         // Update Firestore for Real User AND Automatic Preview User (transient)
         updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', uid), {
           [`watchTimes.${activeVideoRef.current}`]: increment(elapsed)
         }).catch(e => console.error("Error saving time", e));
      }
    };

    if (playingVideoId !== activeVideoRef.current) {
      saveCurrentSession();
      activeVideoRef.current = playingVideoId;
      sessionStartRef.current = playingVideoId ? Date.now() : null;
    }

    window.addEventListener('beforeunload', saveCurrentSession);
    return () => {
      window.removeEventListener('beforeunload', saveCurrentSession);
    };
  }, [playingVideoId]);

  // Catch component unmount (Logout)
  useEffect(() => {
    return () => {
      const { userId: uid, userData: uData, portalId: pId } = stateRefs.current;
      if (activeVideoRef.current && sessionStartRef.current) {
         const elapsed = Math.floor((Date.now() - sessionStartRef.current) / 1000);
         if (elapsed > 0) {
            if (uid && uid.startsWith('preview-manual')) {
                 if (uData && pId) {
                     const updatedTimes = { ...uData.watchTimes };
                     updatedTimes[activeVideoRef.current] = (updatedTimes[activeVideoRef.current] || 0) + elapsed;
                     const updatedUser = { ...uData, watchTimes: updatedTimes };
                     localStorage.setItem(`training_portal_user_${pId}`, JSON.stringify(updatedUser));
                 }
            } else if (uid) {
                updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', uid), {
                  [`watchTimes.${activeVideoRef.current}`]: increment(elapsed)
                }).catch(e => console.error("Error saving time on unmount", e));
            }
         }
      }
    };
  }, []);

  const myVideos = useMemo(() => {
    const assignedDepartments = getAssignedDepartments(userData);
    return VIDEO_DATABASE.filter(v => assignedDepartments.includes(v.category));
  }, [userData]);

  const filteredVideos = useMemo(() => {
    if (!searchQuery) return myVideos;
    return myVideos.filter(v => 
      v.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
      v.category.toLowerCase().includes(searchQuery.toLowerCase())
    );
  }, [myVideos, searchQuery]);

  const videosByCategory = useMemo(() => {
    return filteredVideos.reduce((acc: any, video) => {
      if (!acc[video.category]) acc[video.category] = [];
      acc[video.category].push(video);
      return acc;
    }, {});
  }, [filteredVideos]);

  const watchedCount = userData?.watched?.length || 0;
  const totalCount = myVideos.length;
  const progress = totalCount > 0 ? Math.round((watchedCount / totalCount) * 100) : 0;
  const isComplete = progress === 100;

  const toggleWatch = async (videoId: string) => {
    const currentWatched = userData.watched || [];
    let newWatched;
    if (currentWatched.includes(videoId)) {
      newWatched = currentWatched.filter((id: string) => id !== videoId);
    } else {
      newWatched = [...currentWatched, videoId];
    }

    if (userId && userId.startsWith('preview-manual')) {
      const updatedUser = { ...userData, watched: newWatched };
      setUserData(updatedUser);
      localStorage.setItem(`training_portal_user_${portalId}`, JSON.stringify(updatedUser));
      return;
    }

    try {
      await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', userId), {
        watched: newWatched
      });
    } catch (error) {
      showToast('Failed to update progress', 'error');
    }
  };

  const handleVideoClick = (video: any) => {
    if (playingVideoId === video.id) {
      setPlayingVideoId(null);
      return;
    }
    const embedUrl = getEmbedUrl(video.url);
    if (embedUrl) {
      setPlayingVideoId(video.id);
    } else {
      window.open(video.url, '_blank');
    }
  };

  const handleFinalSubmit = async () => {
    if (!confirm("Confirm you have completed all training videos?")) return;
    setSubmitting(true);

    const isChampion = userData.email && portalInfo?.contactEmail && 
                     userData.email.toLowerCase().trim() === portalInfo.contactEmail.toLowerCase().trim();

    if (userId && userId.startsWith('preview-manual')) {
      setTimeout(() => {
        const updatedUser = { ...userData, status: 'completed', completedAt: new Date().toISOString() };
        setUserData(updatedUser);
        localStorage.setItem(`training_portal_user_${portalId}`, JSON.stringify(updatedUser));
        setShowConfetti(true);
        setSubmitting(false);
      }, 1000);
      return;
    }

    try {
      await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'client_progress', userId), {
        status: 'completed',
        completedAt: serverTimestamp(),
        requiresNotification: isChampion 
      });
      setShowConfetti(true);
      showToast('Congratulations! Training completed.', 'success');
    } catch (error) {
      showToast('Failed to submit', 'error');
    } finally {
      setSubmitting(false);
    }
  };

  const getCategoryProgress = (cat: string) => {
    const categoryVideos = VIDEO_DATABASE.filter(v => v.category === cat);
    if (categoryVideos.length === 0) return 0;
    const done = categoryVideos.filter(v => userData?.watched?.includes(v.id)).length;
    return Math.round((done / categoryVideos.length) * 100);
  };

  const categories = getAssignedDepartments(userData);

  if (!userData) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <Loader2 className="animate-spin text-[#2e69b3] w-8 h-8" />
      </div>
    );
  }

  const displayedCategories = searchQuery ? Object.keys(videosByCategory) : [activeCategory];

  const isChampion = userData.email && portalInfo?.contactEmail && 
                     userData.email.toLowerCase().trim() === portalInfo.contactEmail.toLowerCase().trim();

  return (
    <div className="min-h-screen bg-slate-50 font-sans">
      {/* Confetti Overlay */}
      {showConfetti && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-white/80 backdrop-blur-sm">
          <div className="text-center animate-in zoom-in duration-500">
            <div className="w-32 h-32 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-6 shadow-2xl">
              <Trophy className="w-16 h-16 text-white" />
            </div>
            <h2 className="text-4xl font-bold text-slate-900 mb-2">Congratulations!</h2>
            <p className="text-xl text-slate-600 mb-2">You've completed your training</p>
            <p className="text-slate-500">
              {isPreview ? 'Simulation Complete (No email sent)' : 
               isChampion ? `Notification sent to ${portalInfo?.consultantEmail || 'Consultant'}` : 'Your progress has been recorded.'}
            </p>
            <button
              onClick={() => setShowConfetti(false)}
              className="mt-8 px-6 py-3 bg-[#2e69b3] text-white rounded-xl font-semibold hover:bg-[#255491] transition-colors"
            >
              Continue
            </button>
          </div>
        </div>
      )}

      {/* Header */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        {isPreview && <div className="bg-amber-500 text-xs font-bold text-center py-1 text-slate-900 uppercase tracking-widest">Simulation Mode</div>}
        <div className="max-w-[1600px] mx-auto px-6 py-4">
          <div className="flex items-center justify-between gap-4">
            <div className="flex items-center gap-4">
              <button
                onClick={() => setShowMobileMenu(!showMobileMenu)}
                className="lg:hidden p-2 hover:bg-slate-100 rounded-lg"
              >
                <Menu className="w-5 h-5" />
              </button>
              <div className="flex items-center gap-3">
                <FlyntlokLogo className="w-8 h-8" />
                <div>
                  <h1 className="text-xl font-bold text-slate-900 leading-tight">Training Portal</h1>
                  <p className="text-xs text-slate-500 font-medium">Welcome, {userData.firstName}</p>
                </div>
              </div>
            </div>

            <div className="flex items-center gap-6">
              <div className="hidden md:flex items-center gap-3 pr-6 border-r border-slate-200">
                <div className="text-right">
                  <div className="text-sm font-bold text-slate-900">{watchedCount} / {totalCount}</div>
                  <div className="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Videos</div>
                </div>
                <div className="relative w-10 h-10">
                  <svg className="w-full h-full transform -rotate-90">
                    <circle cx="20" cy="20" r="16" stroke="currentColor" strokeWidth="3" fill="transparent" className="text-slate-100" />
                    <circle
                      cx="20"
                      cy="20"
                      r="16"
                      stroke="currentColor"
                      strokeWidth="3"
                      fill="transparent"
                      className={`transition-all duration-1000 ${progress === 100 ? 'text-emerald-500' : 'text-[#2e69b3]'}`}
                      strokeDasharray={100}
                      strokeDashoffset={100 - (100 * progress) / 100}
                    />
                  </svg>
                  <span className="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-slate-700">
                    {progress}%
                  </span>
                </div>
              </div>

              <div className="flex items-center gap-3">
                <button
                  onClick={() => {
                    const mailto = `mailto:?subject=Training Portal Link&body=Check out this training portal: ${window.location.href}`;
                    window.location.href = mailto;
                  }}
                  className="hidden sm:flex items-center gap-2 px-3 py-2 bg-slate-50 hover:bg-slate-100 text-slate-600 rounded-lg text-sm font-medium transition-colors border border-slate-200"
                >
                  <Share2 className="w-4 h-4" /> Share
                </button>
                <button
                  onClick={onLogout}
                  className="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                  title="Logout"
                >
                  <LogOut className="w-5 h-5" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      {/* Mobile Menu */}
      {showMobileMenu && (
        <div className="lg:hidden fixed inset-0 z-40 bg-white">
          <div className="p-4 border-b border-slate-200 flex justify-between items-center">
            <span className="font-semibold">Departments</span>
            <button onClick={() => setShowMobileMenu(false)}>
              <X className="w-5 h-5" />
            </button>
          </div>
          <div className="p-4 space-y-2">
            {categories.map((dept: string) => {
              const config = DEPARTMENT_CONFIG[dept] || {};
              const Icon = config.icon || Info;
              const catProgress = getCategoryProgress(dept);
              return (
                <button
                  key={dept}
                  onClick={() => { setActiveCategory(dept); setShowMobileMenu(false); }}
                  className={`w-full p-4 rounded-xl flex items-center gap-3 transition-all ${
                    activeCategory === dept ? 'bg-blue-50 border-2 border-[#2e69b3]' : 'bg-slate-50 border-2 border-transparent'
                  }`}
                >
                  <Icon className={`w-5 h-5 ${activeCategory === dept ? 'text-[#2e69b3]' : 'text-slate-500'}`} />
                  <div className="flex-1 text-left">
                    <div className={`font-semibold ${activeCategory === dept ? 'text-[#2e69b3]' : 'text-slate-700'}`}>{dept}</div>
                    <div className="text-xs text-slate-500">{catProgress}% complete</div>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      )}

      <div className="max-w-[1600px] mx-auto px-6 py-8">
        {/* Search */}
        <div className="mb-8">
          <div className="relative max-w-lg">
            <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" />
            <input
              type="text"
              placeholder="Search across all training videos..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full pl-12 pr-4 py-3.5 bg-white border border-slate-200 rounded-xl shadow-sm focus:ring-2 focus:ring-[#2e69b3] focus:border-transparent outline-none transition-all text-slate-700 placeholder:text-slate-400"
            />
            {searchQuery && (
              <button 
                onClick={() => setSearchQuery('')}
                className="absolute right-3 top-1/2 -translate-y-1/2 p-1 hover:bg-slate-100 rounded-full text-slate-400 hover:text-slate-600"
              >
                <X className="w-4 h-4" />
              </button>
            )}
          </div>
        </div>

        {/* Category Tabs - Only show if NOT searching */}
        {!searchQuery && (
          <div className="hidden lg:flex overflow-x-auto gap-4 mb-8 pb-2">
            {categories.map((dept: string) => {
              const catProgress = getCategoryProgress(dept);
              const isDone = catProgress === 100;
              const config = DEPARTMENT_CONFIG[dept] || {};
              const Icon = config.icon || Info;

              return (
                <button
                  key={dept}
                  onClick={() => setActiveCategory(dept)}
                  className={`
                    flex-shrink-0 relative px-5 py-4 rounded-xl border-2 text-left transition-all duration-200 min-w-[200px] group
                    ${activeCategory === dept
                      ? 'border-[#2e69b3] bg-white shadow-md shadow-blue-100/50'
                      : 'border-slate-200 bg-white hover:border-blue-200 text-slate-600'
                    }
                  `}
                >
                  <div className="flex items-center gap-2.5 mb-3">
                    <div className={`p-1.5 rounded-lg ${activeCategory === dept ? 'bg-blue-50 text-[#2e69b3]' : 'bg-slate-100 text-slate-400'}`}>
                      <Icon className="w-5 h-5" />
                    </div>
                    <span className={`font-bold text-sm ${activeCategory === dept ? 'text-[#2e69b3]' : 'text-slate-600'}`}>
                      {dept}
                    </span>
                  </div>
                  <div className="flex items-center gap-3">
                    <div className="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                      <div
                        className={`h-full rounded-full transition-all ${isDone ? 'bg-emerald-500' : 'bg-[#2e69b3]'}`}
                        style={{ width: `${catProgress}%` }}
                      />
                    </div>
                    <span className="text-xs font-bold text-slate-500">{catProgress}%</span>
                  </div>
                  {isDone && (
                    <div className="absolute -top-1.5 -right-1.5 bg-white rounded-full p-0.5 border border-emerald-100">
                      <CheckCircle className="w-5 h-5 text-emerald-500 fill-emerald-50" />
                    </div>
                  )}
                </button>
              );
            })}
          </div>
        )}

        {/* Video Sections */}
        <div className="space-y-12">
          {displayedCategories.map((category: any) => {
            const videos = videosByCategory[category] || [];
            if (videos.length === 0) return null;

            return (
              <div key={category} className="animate-in fade-in slide-in-from-bottom-4 duration-500">
                {/* Category Header (Always show when searching, show only active when not) */}
                <div className="flex items-center gap-3 mb-6 pb-2 border-b border-slate-200">
                  <h2 className="text-xl font-bold text-slate-800">{category}</h2>
                  <span className="bg-slate-100 text-slate-600 text-xs font-semibold px-2.5 py-0.5 rounded-full">
                    {videos.length} Videos
                  </span>
                </div>

                <div className="grid grid-cols-1 gap-6">
                  {videos.map((video: any) => {
                    const isWatched = userData.watched?.includes(video.id);
                    const isPlaying = playingVideoId === video.id;
                    const downloadUrl = getDownloadUrl(video.url);
                    const thumbUrl = getThumbnailUrl(video.url);

                    return (
                      <div
                        key={video.id}
                        className={`
                          bg-white rounded-2xl border transition-all duration-300 overflow-hidden
                          ${isWatched ? 'border-slate-200 bg-slate-50/50' : 'border-slate-200 shadow-sm hover:shadow-md'}
                          ${isPlaying ? 'ring-2 ring-[#2e69b3] shadow-xl' : ''}
                        `}
                      >
                        <div className={`flex ${isPlaying ? 'flex-col' : 'flex-col lg:flex-row'}`}>
                          {/* Video Player / Thumbnail */}
                          {isPlaying ? (
                            <div className="w-full aspect-video bg-black relative">
                              <iframe
                                src={getEmbedUrl(video.url)}
                                className="absolute inset-0 w-full h-full"
                                allow="autoplay; encrypted-media"
                                allowFullScreen
                                title={video.title}
                              />
                            </div>
                          ) : (
                            <div
                              onClick={() => handleVideoClick(video)}
                              className="w-full lg:w-80 h-48 lg:h-auto min-h-[12rem] bg-slate-900 relative group cursor-pointer overflow-hidden shrink-0"
                            >
                              {thumbUrl ? (
                                <img src={thumbUrl} alt={video.title} className="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-overlay group-hover:scale-105 transition-transform duration-700" onError={(e: any) => { e.target.style.display = 'none'; }} />
                              ) : (
                                <div className="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&w=800&q=80')] bg-cover bg-center opacity-40 mix-blend-overlay"></div>
                              )}
                              <div className="absolute inset-0 bg-gradient-to-t from-slate-900/90 to-slate-900/20 group-hover:to-slate-900/40 transition-all" />
                              <div className="absolute inset-0 flex items-center justify-center">
                                <div className="w-14 h-14 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center group-hover:scale-110 transition-transform duration-300 border border-white/30">
                                  <Play className="w-6 h-6 text-white ml-1" fill="currentColor" />
                                </div>
                              </div>
                              {video.duration && (
                                <div className="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs font-medium px-2 py-1 rounded">
                                  {video.duration}
                                </div>
                              )}
                              {isWatched && (
                                <div className="absolute top-3 left-3 bg-emerald-500 text-white text-xs font-bold px-2 py-1 rounded-md flex items-center gap-1 shadow-sm">
                                  <Check className="w-3 h-3" strokeWidth={3} /> Watched
                                </div>
                              )}
                            </div>
                          )}

                          {/* Content */}
                          <div className="p-6 flex-1 flex flex-col justify-between">
                            <div>
                              <div className="flex justify-between items-start gap-4">
                                <h3 className={`font-bold text-lg leading-tight ${isWatched && !isPlaying ? 'text-slate-500' : 'text-slate-900'}`}>
                                  {video.title}
                                </h3>
                                {isPlaying && (
                                  <button
                                    onClick={() => setPlayingVideoId(null)}
                                    className="p-2 hover:bg-slate-100 rounded-lg text-slate-400 hover:text-slate-600 transition-colors"
                                  >
                                    <X className="w-5 h-5" />
                                  </button>
                                )}
                              </div>
                              <p className="text-sm text-slate-500 mt-2 leading-relaxed">
                                {isPlaying 
                                  ? 'Video is playing. Don\'t forget to mark it as complete once you are finished.' 
                                  : 'Click the thumbnail to start watching this training module.'}
                              </p>
                            </div>

                            <div className="flex flex-wrap items-center gap-3 mt-6 pt-5 border-t border-slate-100">
                              <button
                                onClick={() => handleVideoClick(video)}
                                className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${
                                  isPlaying
                                    ? 'bg-red-50 text-red-600 hover:bg-red-100 border border-red-100'
                                    : 'bg-blue-50 text-[#2e69b3] hover:bg-blue-100 border border-blue-100'
                                }`}
                              >
                                {isPlaying ? <Minimize2 className="w-4 h-4" /> : <Play className="w-4 h-4" />}
                                {isPlaying ? 'Close Player' : 'Watch Now'}
                              </button>

                              {downloadUrl && (
                                <a
                                  href={downloadUrl}
                                  target="_blank"
                                  rel="noreferrer"
                                  className="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 border border-slate-200 transition-colors"
                                >
                                  <Download className="w-4 h-4" /> Download
                                </a>
                              )}

                              <button
                                onClick={() => toggleWatch(video.id)}
                                className={`
                                  ml-auto px-5 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2 shadow-sm
                                  ${isWatched
                                    ? 'bg-white border border-slate-200 text-slate-500 hover:bg-slate-50 hover:text-slate-700'
                                    : 'bg-[#2e69b3] text-white hover:bg-[#255491] hover:shadow-md'
                                  }
                                `}
                              >
                                {isWatched ? (
                                  <><XCircle className="w-4 h-4" /> Mark Unwatched</>
                                ) : (
                                  <><CheckCircle className="w-4 h-4" /> Mark Complete</>
                                )}
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}

          {displayedCategories.length === 0 && (
            <div className="text-center py-20 bg-white rounded-2xl border border-slate-200">
              <div className="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <Search className="w-8 h-8 text-slate-300" />
              </div>
              <h3 className="text-lg font-semibold text-slate-700 mb-1">No videos found</h3>
              <p className="text-slate-500">Try adjusting your search terms.</p>
              <button 
                onClick={() => setSearchQuery('')}
                className="mt-4 text-[#2e69b3] font-semibold hover:underline"
              >
                Clear Search
              </button>
            </div>
          )}
        </div>

        {/* Completion Section */}
        <div className="mt-16 flex flex-col items-center pb-12">
          {isComplete ? (
            <div className="w-full max-w-md text-center">
              <button
                onClick={handleFinalSubmit}
                disabled={submitting || userData.status === 'completed'}
                className={`
                  w-full py-4 rounded-2xl font-bold text-lg text-white shadow-xl transition-all flex items-center justify-center gap-3
                  ${userData.status === 'completed'
                    ? 'bg-emerald-600 cursor-default ring-4 ring-emerald-100'
                    : 'bg-gradient-to-r from-[#2e69b3] to-[#255491] hover:from-[#255491] hover:to-[#1e4374] hover:shadow-2xl hover:-translate-y-0.5'
                  }
                `}
              >
                {submitting ? <Loader2 className="w-6 h-6 animate-spin" /> : <Award className="w-6 h-6" />}
                {userData.status === 'completed' ? 'Training Certification Submitted' : 'Submit Final Completion'}
              </button>
              {userData.status === 'completed' && (
                <p className="text-emerald-700 font-medium mt-4 flex items-center justify-center gap-2 bg-emerald-50 py-2 px-4 rounded-lg inline-flex">
                  <CheckCircle className="w-5 h-5" />
                  {isChampion ? 'Success! Your consultant has been notified.' : 'Training recorded successfully.'}
                </p>
              )}
            </div>
          ) : (
            <div className="flex items-center gap-3 px-8 py-5 bg-slate-100 border border-slate-200 rounded-2xl text-slate-600 shadow-inner">
              <TrendingUp className="w-5 h-5 text-slate-400" />
              <span className="font-medium">Complete all {totalCount} videos to unlock certification</span>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
